# Copy to backend/.env (git-ignored) and fill in. Never commit the real file.

# --- Gemini natural-language understanding (optional; the chatbot works without it) ---
GEMINI_API_KEY=your_api_key_here          # from https://aistudio.google.com/apikey ; server-side only
GEMINI_MODEL=gemini-3.5-flash-lite        # any Gemini model your account can use; see docs/GEMINI.md
GEMINI_TIMEOUT_S=15                       # per-request timeout in seconds (minimum 10; lower values are raised to 10)
GEMINI_MAX_RETRIES=1                      # retries for timeouts / 5xx only (0-2)
GEMINI_ENABLED=true                       # set false to force the rule-based parser

# --- Application (defaults work out of the box) ---
TRIPWISE_DB=./tripwise.db                 # SQLite file for saved trips and chat sessions
TRIPWISE_DATA_DIR=./datasets/processed
TRIPWISE_CORS=http://localhost:5173
